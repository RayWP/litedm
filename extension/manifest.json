{
  "manifest_version": 3,
  "name": "LiteDM Browser Bridge",
  "version": "1.0.0",
  "description": "Send a link to LiteDM for review.",
  "permissions": ["contextMenus", "nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "LiteDM Browser Bridge",
    "default_popup": "popup.html"
  }
}
