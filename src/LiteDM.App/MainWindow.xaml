<Window
    x:Class="LiteDM.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LiteDM">
    <Grid x:Name="Root" Background="{ThemeResource AppBackground}" MinWidth="640" MinHeight="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="24,18,24,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="LiteDM" FontSize="25" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryText}" />
                <TextBlock Text="Downloads" FontSize="13" Foreground="{ThemeResource SecondaryText}" />
            </StackPanel>
            <Button x:Name="SettingsButton" Grid.Column="1" Content="Settings" Click="Settings_Click" AutomationProperties.Name="Open settings" />
        </Grid>
        <Grid Grid.Row="1" Padding="24,0,24,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="UrlBox" Header="Download URL" PlaceholderText="Paste a download link" Background="{ThemeResource SurfaceAlt}" AutomationProperties.Name="Download URL" KeyDown="UrlBox_KeyDown" />
            <Button x:Name="AddButton" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom" Content="Add download" Style="{StaticResource AccentButtonStyle}" Click="Add_Click" />
        </Grid>
        <Border x:Name="NoticeBorder" Grid.Row="2" Margin="24,0,24,12" Padding="12,9" CornerRadius="4" Background="{ThemeResource SurfaceAlt}" Visibility="Collapsed">
            <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="{ThemeResource PrimaryText}" />
        </Border>
        <Grid Grid.Row="3" Margin="24,0,24,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{ThemeResource Surface}" CornerRadius="4" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="History" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryText}"/>
                    <TextBox x:Name="HistorySearch" Grid.Row="1" Header="Search history" PlaceholderText="File name" TextChanged="HistorySearch_Changed"/>
                    <ComboBox x:Name="HistoryFilter" Grid.Row="2" Header="Status" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="HistoryFilter_Changed">
                        <ComboBoxItem Content="All statuses"/>
                        <ComboBoxItem Content="Failed"/>
                        <ComboBoxItem Content="Finish"/>
                        <ComboBoxItem Content="Paused"/>
                        <ComboBoxItem Content="Corrupt"/>
                    </ComboBox>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HistoryEntries" Spacing="6"/>
                    </ScrollViewer>
                    <TextBlock x:Name="HistoryEmpty" Grid.Row="3" Text="No history yet" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryText}"/>
                </Grid>
            </Border>
            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Transfers" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource PrimaryText}"/>
                    <Button x:Name="RemoveStoppedButton" Grid.Column="1" Content="Remove stopped" IsEnabled="False" Click="RemoveStopped_Click"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="JobsPanel" Spacing="8"/>
                </ScrollViewer>
                <StackPanel x:Name="EmptyPanel" Grid.Row="1" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="No active downloads" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryText}"/>
                    <TextBlock Text="Add an HTTP or HTTPS link to start a download." TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryText}"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="4" BorderBrush="{ThemeResource Line}" BorderThickness="0,1,0,0" Padding="24,10">
            <TextBlock x:Name="FooterText" Text="Loading saved downloads…" FontSize="12" Foreground="{ThemeResource SecondaryText}" />
        </Border>
    </Grid>
</Window>
